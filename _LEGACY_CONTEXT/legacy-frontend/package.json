{
  "name": "macroflow-ai",
  "version": "1.0.0",
  "description": "Generate VBA macros with AI",
  "main": "taskpane.html",
  "scripts": {
    "start": "cd .. && scripts\\sideload-production.bat",
    "stop": "cd .. && scripts\\remove-sideload.bat",
    "sideload": "cd .. && scripts\\sideload-production.bat",
    "remove": "cd .. && scripts\\remove-sideload.bat",
    "build": "webpack --mode production",
    "dev": "webpack serve --mode development",
    "validate": "office-addin-manifest validate manifest.xml",
    "lint": "eslint *.js"
  },
  "dependencies": {
    "core-js": "^3.36.0",
    "express": "^5.1.0",
    "regenerator-runtime": "^0.14.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.25.4",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^7.1.2",
    "eslint": "^8.57.0",
    "html-webpack-plugin": "^5.6.0",
    "office-addin-cli": "^2.0.3",
    "office-addin-debugging": "^6.0.3",
    "office-addin-dev-certs": "^2.0.3",
    "office-addin-manifest": "^2.0.3",
    "style-loader": "^4.0.0",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/macroflow-ai/macroflow-ai.git"
  },
  "keywords": [
    "excel",
    "vba",
    "ai",
    "openai",
    "macro",
    "automation"
  ],
  "author": "MacroFlow",
  "license": "MIT"
}
