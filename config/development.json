{
  "environment": "development",
  "debug": true,
  "backend": {
    "host": "localhost",
    "port": 5000,
    "cors_origins": ["https://localhost:3000"]
  },
  "frontend": {
    "host": "localhost",
    "port": 3000,
    "https": true
  },
  "openai": {
    "model": "gpt-4o",
    "temperature": 0.1,
    "max_tokens": 2000
  },
  "cache": {
    "sheet_context_duration": 30,
    "conversation_history_limit": 5
  },
  "logging": {
    "level": "DEBUG",
    "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
  }
}